<?xml version="1.0" standalone="no" ?>
<manifest identifier="com.perplexity.pdf.flipbook" version="1"
         xmlns="http://www.imsproject.org/xsd/imscp1p1p2"
         xmlns:adlcp="http://www.adlnet.org/xsd/adlcp_rootv1p2"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://www.imsproject.org/xsd/imscp1p1p2 imscp_rootv1p1p2.xsd
                             http://www.adlnet.org/xsd/adlcp_rootv1p2 adlcp_rootv1p2.xsd">

  <metadata>
    <schema>ADL SCORM</schema>
    <schemaversion>1.2</schemaversion>
  </metadata>

  <organizations default="pdf_flipbook_org">
    <organization identifier="pdf_flipbook_org">
      <title>PDF Flipbook</title>
      <item identifier="pdf_flipbook_item" identifierref="pdf_flipbook_resource">
        <title>PDF Flipbook</title>
        <adlcp:data>
          <adlcp:location>index.html</adlcp:location>
        </adlcp:data>
      </item>
    </organization>
  </organizations>

  <resources>
    <resource identifier="pdf_flipbook_resource" type="webcontent" adlcp:scormtype="asset" href="index.html">
      <file href="index.html"/>
    </resource>
  </resources>
</manifest>